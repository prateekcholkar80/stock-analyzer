ANGEL_API_KEY="my_secret_api_key"
ANGEL_CLIENT_CODE="my_client_code"
ANGEL_PIN="my_pin"
ANGEL_TOTP_SECRET="my_totp_secret"

# Optional: only needed to run the Bull/Bear debate agents against a real
# LLM provider. The Bull/Bear/Judge agents pick their model via a plain
# "<provider>/<model>" string (see app/agents/bull_agent.py,
# app/agents/bear_agent.py, app/agents/debate_judge_agent.py); litellm
# reads the matching provider key straight from the environment, e.g.:
# ANTHROPIC_API_KEY="my_anthropic_key"
# OPENAI_API_KEY="my_openai_key"
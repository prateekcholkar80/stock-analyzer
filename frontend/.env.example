NEXT_PUBLIC_JARVIS_API_URL="http://127.0.0.1:8000"

# Non-secret identifiers for the user-owned Tijori connection registered by
# the Python API bootstrap. The connection ID must match
# JARVIS_TIJORI_CONNECTION_ID. Leave the optional hash blank unless the backend
# uses the same precomputed, non-reversible account reference hash.
NEXT_PUBLIC_JARVIS_TIJORI_CONNECTION_ID="provider.tijori.local_user"
NEXT_PUBLIC_JARVIS_TIJORI_ACCOUNT_REFERENCE_HASH=""

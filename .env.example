ANGEL_API_KEY="my_secret_api_key"
ANGEL_CLIENT_CODE="my_client_code"
ANGEL_PIN="my_pin"
ANGEL_TOTP_SECRET="my_totp_secret"

# Optional Angel instrument-master settings. Defaults shown below. The
# downloaded cache is sticky (no automatic expiry) -- call .refresh() to
# force a fresh download.
ANGEL_INSTRUMENT_MASTER_URL="https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json"
ANGEL_INSTRUMENT_CACHE_PATH="data/cache/angel_instrument_master.json"
ANGEL_INSTRUMENT_DOWNLOAD_TIMEOUT_SECONDS="30"

# Ticker-resolver LLM role, used only when a partial/ambiguous company
# name cannot be resolved by exact match. Optional; falls back to
# JARVIS_LLM_MODEL when unset.
JARVIS_TICKER_RESOLVER_LLM_MODEL=""
JARVIS_TICKER_RESOLVER_LLM_TEMPERATURE="0.0"
JARVIS_TICKER_RESOLVER_LLM_MAX_TOKENS="300"

# Jarvis activates from either typed text or a voice transcript when this
# phrase appears at the beginning of the input.
JARVIS_USER_NAME="your_name"
JARVIS_WAKE_PHRASE="Hey Jarvis"

# Number of consecutive failed instrument resolutions before Jarvis offers
# to refresh its NSE company list (always with a yes/no confirmation first).
JARVIS_RESOLUTION_FAILURE_THRESHOLD="3"

# Development-only review trail. When enabled, this writes full sanitized
# conversation text and Jarvis/Bull/Bear/Judge prompts/responses to a private JSONL
# file. Keep it disabled where prompts may contain sensitive research data.
JARVIS_PROMPT_AUDIT_ENABLED="false"
JARVIS_PROMPT_AUDIT_PATH="logs/jarvis-prompt-audit.jsonl"

# Required for the full Bull/Bear/Judge debate. Use a provider/model string
# understood by the configured LLM gateway. Role-specific values are optional
# overrides; a blank override inherits JARVIS_LLM_MODEL.
JARVIS_LLM_MODEL="provider/your-model"
JARVIS_BULL_LLM_MODEL=""
JARVIS_BEAR_LLM_MODEL=""
JARVIS_JUDGE_LLM_MODEL=""
JARVIS_PERSONA_LLM_MODEL=""

JARVIS_BULL_LLM_TEMPERATURE="0.4"
JARVIS_BEAR_LLM_TEMPERATURE="0.4"
JARVIS_JUDGE_LLM_TEMPERATURE="0.0"
JARVIS_PERSONA_LLM_TEMPERATURE="0.2"

JARVIS_BULL_LLM_MAX_TOKENS="800"
JARVIS_BEAR_LLM_MAX_TOKENS="800"
JARVIS_JUDGE_LLM_MAX_TOKENS="600"
JARVIS_PERSONA_LLM_MAX_TOKENS="5000"

# Provider credentials remain external to Jarvis LLM settings. Configure only
# the credential required by the selected gateway/provider, for example:
# ANTHROPIC_API_KEY="my_anthropic_key"
# OPENAI_API_KEY="my_openai_key"

# Text-to-speech (spoken conversation replies). Optional -- the /speech
# endpoint simply doesn't exist if TTS isn't composed. Provider is a config
# switch, not a code change; "google" and "elevenlabs" are both implemented.
# Voice/accent are configurable, not hardcoded.
# - provider="google": JARVIS_TTS_VOICE_NAME is a named voice (e.g.
#   en-GB-Neural2-B for a British-accented persona voice); falls back to
#   JARVIS_TTS_LANGUAGE_CODE if unset.
# - provider="elevenlabs": JARVIS_TTS_VOICE_NAME must be an ElevenLabs voice
#   ID (from https://elevenlabs.io/app/voice-library, or the "Voices" tab in
#   your account) -- there is no fallback, ElevenLabs requires one.
JARVIS_TTS_PROVIDER="google"
JARVIS_TTS_VOICE_NAME="en-GB-Neural2-B"
JARVIS_TTS_LANGUAGE_CODE="en-GB"
JARVIS_TTS_AUDIO_ENCODING="MP3"
JARVIS_TTS_SPEAKING_RATE="1.0"
# ElevenLabs-only: which of their models to use (e.g. eleven_v3,
# eleven_multilingual_v2, eleven_turbo_v2_5). Ignored by the Google adapter.
# JARVIS_TTS_MODEL_ID="eleven_v3"

# Google Cloud TTS/STT both authenticate via Application Default Credentials,
# not a Jarvis-specific setting -- point this at your downloaded
# service-account key file. See the setup steps in chat/README for how to
# create it.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# Required when JARVIS_TTS_PROVIDER or JARVIS_STT_PROVIDER is
# "elevenlabs" (same account, same key for both). Create a key scoped to
# "Text to Speech" and "Speech to Text" permissions only (no
# Voices/History/etc.) in the ElevenLabs dashboard.
# ELEVENLABS_API_KEY="your_elevenlabs_key"

# Speech-to-text (voice input). Optional -- the /transcribe endpoint simply
# doesn't exist if STT isn't composed. Provider is a config switch, not a
# code change; "google" and "elevenlabs" are both implemented. Language
# code is independent of JARVIS_TTS_LANGUAGE_CODE by design: what the user
# speaks in and what Jarvis replies in are never coupled.
# - provider="google": JARVIS_STT_LANGUAGE_CODE is a BCP-47 tag (e.g.
#   en-IN) passed through as-is.
# - provider="elevenlabs": only the primary subtag is sent (en-IN -> en),
#   since ElevenLabs expects a bare ISO-639-1/3 code; it's an optional
#   hint, ElevenLabs auto-detects language well on its own.
JARVIS_STT_PROVIDER="google"
JARVIS_STT_LANGUAGE_CODE="en-IN"
JARVIS_STT_AUDIO_ENCODING="WEBM_OPUS"
# JARVIS_STT_SAMPLE_RATE_HERTZ="16000"
# ElevenLabs-only: which of their STT models to use (scribe_v1, scribe_v2).
# Ignored by the Google adapter; defaults to scribe_v1 if unset.
# JARVIS_STT_MODEL_ID="scribe_v1"
